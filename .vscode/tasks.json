{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Install",
      "type": "shell",
      "command": "pnpm build-and-install",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Watch",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Build success"
        }
      }
    }
  ]
}
